---
import { Icon } from "@astrojs/starlight/components";

const t = Astro.locals.t;
---

{
	/* A light/dark switch for the mobile header bar, where Starlight's
three-option theme select is not shown.

IT OWNS NO STATE. On click it sets `value` on the select inside
`starlight-theme-select` and dispatches a bubbling `change`; Starlight's
own handler is what writes `data-theme` and `localStorage`, and what
calls `StarlightThemeProvider.updatePickers()` to bring every other
picker on the page along with it. Writing the theme here as well would
give the page two authorities for one value, and the loser of that race
is the before-paint script in ThemeProvider.astro — which is how a page
ends up painting the wrong theme for a frame.

The `Auto` option is deliberately not in this control's cycle: a
two-state button that silently has a third state is a worse control
than a two-state one. Auto stays one tap away, in the full select that
Starlight renders in the mobile menu drawer (MobileMenuFooter.astro).

The icon is swapped in CSS off `:root[data-theme]`, not in script, so
it is already correct in the first painted frame. It shows the CURRENT
theme, matching what the select's own label icon shows, rather than the
one a tap would move to. */
}
<rb-theme-toggle
	data-dark={t("themeSelect.dark")}
	data-light={t("themeSelect.light")}
>
	<button type="button" class="toggle">
		{
			/* The accessible name is "Select theme: Dark" — the label, then the
		state, both from Starlight's own translation files, so this component
		introduces no string that would need translating by hand. The state
		half is filled in and kept current by the script below. */
		}
		<span class="sr-only">{`${t("themeSelect.accessibleLabel")}: `}</span>
		<span class="sr-only" data-state></span>
		<Icon name="sun" class="icon light-only" />
		<Icon name="moon" class="icon dark-only" />
	</button>
</rb-theme-toggle>

<style>
	rb-theme-toggle {
		display: contents;
	}

	.toggle {
		/* 44 x 44 px, the size chrome.css already gives sidebar and
		   pagination links under a coarse pointer. That figure is WCAG 2.2
		   SC 2.5.5 (Level AAA); the Level AA minimum, SC 2.5.8, is 24 x 24.
		   Matching the rest of the chrome matters more than the floor. */
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: var(--rb-radius);
		background: none;
		/* The same two colours Starlight's own Select label uses, so the
		   toggle and the select it drives are the same control visually. */
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.toggle:hover {
		color: var(--sl-color-white);
	}

	.icon {
		font-size: 1.25rem;
	}

	/* Starlight's breakpoint, copied as a number because it is not exposed
	   as a custom property. Above it the full theme select is in the header
	   bar and this control would be a second, redundant one. */
	@media (min-width: 50rem) {
		.toggle {
			display: none;
		}
	}

	/* `:root` carries the dark theme in this project (see theme.css), so
	   "not light" is the dark case and the moon is what a page shows before
	   any explicit choice has been made. */
	:global(:root:not([data-theme="light"])) .light-only {
		display: none;
	}
	:global(:root[data-theme="light"]) .dark-only {
		display: none;
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector("button");
			const state = this.querySelector<HTMLElement>("[data-state]");
			if (!button || !state) return;

			/** Whichever theme the document is currently painting. */
			const current = (): "dark" | "light" =>
				document.documentElement.dataset.theme === "light" ? "light" : "dark";

			/** Reads the state back off the document, never off a local copy. */
			const sync = () => {
				state.textContent = this.dataset[current()] ?? "";
			};

			sync();
			// `data-theme` is written by Starlight — by the before-paint script
			// in ThemeProvider.astro and by ThemeSelect's change handler. This
			// observer is the only way this control learns the theme, so it
			// cannot disagree with either of them, or with the desktop select.
			new MutationObserver(sync).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});

			button.addEventListener("click", () => {
				void (async () => {
					const next = current() === "light" ? "dark" : "light";
					// A tap can land before the ThemeSelect module has run, and
					// its `change` listener is attached in the element's
					// constructor. Waiting for the definition means the click is
					// never dropped silently.
					await customElements.whenDefined("starlight-theme-select");
					const select = document.querySelector<HTMLSelectElement>(
						"starlight-theme-select select",
					);
					if (!select) return;
					select.value = next;
					select.dispatchEvent(new Event("change", { bubbles: true }));
				})();
			});
		}
	}

	customElements.define("rb-theme-toggle", ThemeToggle);
</script>
