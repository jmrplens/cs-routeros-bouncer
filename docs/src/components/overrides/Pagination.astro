---
import { Icon } from "@astrojs/starlight/components";

const { dir, pagination, sidebar } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === "rtl";

type SidebarEntry = (typeof sidebar)[number];

/**
 * Maps every page's href to the label of the sidebar group that holds it.
 *
 * Starlight builds prev/next by flattening the sidebar to a list of links
 * (utils/navigation.ts, `getPrevNextLinks`) and keeping only the label and
 * the href — the group each page sits under is dropped on the way. That is
 * why two different pages can both hand this component the label "Overview".
 * The group is still in `starlightRoute.sidebar`, so it is recovered here by
 * href rather than reintroduced by hand.
 *
 * The NEAREST enclosing group wins, not the outermost: with today's
 * two-level tree they are the same label, and if a group ever nests inside
 * another the nearer one is the more precise answer.
 *
 * Group labels come from the same `translations` maps as the sidebar's, so
 * this needs no strings of its own in either language.
 */
function collectGroups(
	entries: SidebarEntry[],
	group: string | undefined,
	into: Map<string, string>,
): Map<string, string> {
	for (const entry of entries) {
		if (entry.type === "group") {
			collectGroups(entry.entries, entry.label, into);
		} else if (group !== undefined) {
			into.set(entry.href, group);
		}
	}
	return into;
}

const groups = collectGroups(sidebar, undefined, new Map<string, string>());

// A page can override prev/next in its frontmatter with a bare URL, which is
// not in the map; those simply render without a group line.
const prevGroup = prev && groups.get(prev.href);
const nextGroup = next && groups.get(next.href);
---

{
	/* A copy of Starlight's Pagination.astro (0.41.8), not a wrapper: the
group has to sit inside the card, and a wrapper cannot reach in. The
markup below differs from upstream in exactly two ways —

  1. the `Previous` / `Next` line and the group label share one `.meta`
     line, so the card reads "Next · Configuration" over "Overview"
     instead of "Next" over an "Overview" that names nothing;
  2. the `<br>` upstream uses to break the two lines is gone, replaced
     by a column flex container, because there are now up to three
     pieces and one of them is conditional.

Because this replaces the component, Starlight's scoped styles for
`.pagination-links`, `a`, `[rel='next']` and `.link-title` are no
longer emitted for this page and are carried below verbatim, still
inside `@layer starlight.core` — chrome.css's unlayered
`.pagination-links a` rules must keep winning over them exactly as
they did before. */
}
<div class="pagination-links print:hidden" dir={dir}>
	{
		prev && (
			<a href={prev.href} rel="prev">
				<Icon name={isRtl ? "right-arrow" : "left-arrow"} size="1.5rem" />
				<span class="stack">
					<span class="meta">
						{Astro.locals.t("page.previousLink")}
						{prevGroup && (
							<>
								<span aria-hidden="true">·</span>
								{prevGroup}
							</>
						)}
					</span>
					<span class="link-title">{prev.label}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={next.href} rel="next">
				<Icon name={isRtl ? "left-arrow" : "right-arrow"} size="1.5rem" />
				<span class="stack">
					<span class="meta">
						{Astro.locals.t("page.nextLink")}
						{nextGroup && (
							<>
								<span aria-hidden="true">·</span>
								{nextGroup}
							</>
						)}
					</span>
					<span class="link-title">{next.label}</span>
				</span>
			</a>
		)
	}
</div>

<style>
	@layer starlight.core {
		/* ---- Verbatim from Starlight 0.41.8 ---------------------------- */
		.pagination-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
			gap: 1rem;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 0.5rem;
			width: 100%;
			flex-basis: calc(50% - 0.5rem);
			flex-grow: 1;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			padding: 1rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			box-shadow: var(--sl-shadow-md);
			overflow-wrap: anywhere;
		}
		[rel="next"] {
			justify-content: end;
			text-align: end;
			flex-direction: row-reverse;
		}
		a:hover {
			border-color: var(--sl-color-gray-2);
		}

		.link-title {
			color: var(--sl-color-white);
			font-size: var(--sl-text-2xl);
			line-height: var(--sl-line-height-headings);
		}

		svg {
			flex-shrink: 0;
		}

		/* ---- Added here ------------------------------------------------ */

		/* Replaces upstream's `<br>`: the pieces are stacked as blocks so a
		   conditional third one does not need a conditional line break. */
		.stack {
			display: flex;
			flex-direction: column;
		}

		/* `--sl-color-gray-3` on the page background is the pair
		   check-contrast.mjs already gates as "muted meta text", so this
		   line introduces no colour the gate cannot see. The separator is
		   `aria-hidden` in the markup: it is punctuation between two labels,
		   and some screen readers announce a bare middle dot. */
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0 0.4em;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
		}
		[rel="next"] .meta {
			justify-content: end;
		}
	}
</style>
