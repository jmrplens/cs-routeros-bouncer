{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "analyze": "pnpm run config:check && pnpm run brand:check && pnpm run i18n:check && pnpm run contrast:check && pnpm run check && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run html:validate && pnpm run cards:check",
    "brand:rasters": "node scripts/render-brand-rasters.mjs",
    "brand:check": "node scripts/render-brand-rasters.mjs --check",
    "config:extract": "node scripts/extract-config-schema.mjs",
    "config:check": "node scripts/extract-config-schema.mjs --check",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html:validate": "test -n \"$(find dist -name '*.html' -print -quit 2>/dev/null)\" || { echo 'No HTML files found in docs/dist. Run pnpm build first.' >&2; exit 1; }; html-validate --max-warnings 0 \"dist/**/*.html\"",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "playwright:install": "playwright install --with-deps chromium",
    "cards:check": "node scripts/check-social-cards.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "markdownlint-cli2": "0.23.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "2.9.1"
  }
}
