{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "analyze": "pnpm run config:check && pnpm run brand:check && pnpm run charts:check && pnpm run i18n:check && pnpm run contrast:check && pnpm run check && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run html:validate && pnpm run cards:check",
    "brand:rasters": "node scripts/render-brand-rasters.mjs",
    "brand:check": "node scripts/render-brand-rasters.mjs --check",
    "config:extract": "node scripts/extract-config-schema.mjs",
    "config:check": "node scripts/extract-config-schema.mjs --check",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html:validate": "test -n \"$(find dist -name '*.html' -print -quit 2>/dev/null)\" || { echo 'No HTML files found in docs/dist. Run pnpm build first.' >&2; exit 1; }; html-validate --max-warnings 0 \"dist/**/*.html\"",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "playwright:install": "playwright install --with-deps chromium",
    "cards:check": "node scripts/check-social-cards.mjs",
    "charts:check": "node scripts/render-perf-charts.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.2",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "markdownlint-cli2": "0.24.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "2.9.1"
  }
}
