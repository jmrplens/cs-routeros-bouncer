FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S bouncer && adduser -S bouncer -G bouncer

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/cs-routeros-bouncer /usr/local/bin/cs-routeros-bouncer

RUN mkdir -p /etc/cs-routeros-bouncer && \
    chown bouncer:bouncer /etc/cs-routeros-bouncer

USER bouncer

LABEL org.opencontainers.image.title="cs-routeros-bouncer" \
      org.opencontainers.image.description="CrowdSec bouncer for MikroTik RouterOS" \
      org.opencontainers.image.source="https://github.com/jmrplens/cs-routeros-bouncer" \
      org.opencontainers.image.license="MIT"

EXPOSE 2112

# Exec form, no shell: busybox wget exits 0 on success and 1 on every failure
# mode (refused, DNS, timeout, 404, 500 — verified empirically on alpine 3.24),
# so the traditional `|| exit 1` normalisation has nothing to normalise here.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-qO-", "http://localhost:2112/health"]

ENTRYPOINT ["cs-routeros-bouncer"]
