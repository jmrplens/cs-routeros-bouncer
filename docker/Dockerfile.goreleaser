# The image's files are put together on the build platform: Alpine has no
# linux/arm/v5 image, and the stage below runs no code of the target platform.
FROM --platform=$BUILDPLATFORM alpine:3.24 AS rootfs

COPY --from=busybox:1.37-uclibc /etc/passwd /etc/group /rootfs/etc/

RUN apk add --no-cache ca-certificates tzdata && \
    mkdir -p /rootfs/etc/ssl/certs /rootfs/usr/share /rootfs/etc/cs-routeros-bouncer /rootfs/home/bouncer && \
    cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ && \
    cp -r /usr/share/zoneinfo /rootfs/usr/share/ && \
    echo "bouncer:x:101:" >> /rootfs/etc/group && \
    echo "bouncer:x:100:101:Linux User,,,:/home/bouncer:/bin/false" >> /rootfs/etc/passwd && \
    chown 100:101 /rootfs/etc/cs-routeros-bouncer /rootfs/home/bouncer

# busybox (uClibc, static) runs on every platform the release ships,
# linux/arm/v5 included, and brings the wget the healthcheck calls.
FROM busybox:1.37-uclibc

COPY --from=rootfs /rootfs/ /

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/cs-routeros-bouncer /usr/local/bin/cs-routeros-bouncer

USER bouncer

LABEL org.opencontainers.image.title="cs-routeros-bouncer" \
      org.opencontainers.image.description="CrowdSec bouncer for MikroTik RouterOS" \
      org.opencontainers.image.source="https://github.com/jmrplens/cs-routeros-bouncer" \
      org.opencontainers.image.license="MIT"

EXPOSE 2112

# Exec form, no shell: busybox wget exits 0 on success and 1 on every failure
# mode (refused, DNS, timeout, 404, 500 — the applet alpine 3.24 ships too),
# so the traditional `|| exit 1` normalisation has nothing to normalise here.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-qO-", "http://localhost:2112/health"]

ENTRYPOINT ["cs-routeros-bouncer"]
